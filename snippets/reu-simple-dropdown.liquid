{% stylesheet %}
  /*
    Override Horizon's full-width submenu behavior.
    The existing .menu-list__submenu is position:absolute relative to a high ancestor
    with width:100%, left:0, and clip-path that creates the full-width background.
    Adding position:relative to the <li> changes the containing block to the list item,
    then we reset width, top, clip-path, and padding to make a standard narrow dropdown.
  */
  .menu-list__list-item--simple-dropdown {
    position: relative;
  }

  .menu-list__list-item--simple-dropdown > .menu-list__submenu {
    width: auto;
    top: 100%;
    clip-path: none;
    padding-inline: 0;
  }

  .menu-list__list-item--simple-dropdown .menu-list__submenu-inner {
    padding-block-start: 0;
    padding-block-end: 0;
    padding-inline: 0;
    transform: none;
  }

  /*
    The JS sets --submenu-height and --full-open-header-height as inline styles on
    header-component for all submenu activations, which causes header__underlay-open
    to expand as a full-width background panel. CSS can't override inline custom
    properties, so we target the underlay element directly via :has() instead.

    The base rule adds a 500ms delayed opacity transition. When aria-expanded goes
    false (our :has() stops matching), opacity stays at 0 for 500ms before snapping
    to 1 — giving the JS time to reset --full-open-header-height to 0 first.
    CSS transitions use the TARGET state's declaration, so:
      - Opening: target is the :has() rule → transition:none → instant hide
      - Closing: target is the base rule → 500ms delay → no flash
  */
  header-component .header__underlay-open {
    transition: opacity 0s 0.5s linear;
  }

  header-component:has(.menu-list__list-item--simple-dropdown .menu-list__link[aria-expanded='true']) .header__underlay-open {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: none !important;
  }

  .reu-simple-dropdown {
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    padding: 0.375rem 0;
    min-width: 13rem;
    list-style: none;
    margin: 0;
  }

  .reu-simple-dropdown__link {
    display: block;
    padding: 0.5rem 1.25rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }

  .reu-simple-dropdown__link:hover,
  .reu-simple-dropdown__link:focus {
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    outline: none;
  }

  .reu-simple-dropdown__link[aria-current="page"] {
    font-weight: 600;
  }
{% endstylesheet %}

<ul class="reu-simple-dropdown" role="menu">
  {%- for child_link in links -%}
    <li role="none">
      <a
        href="{{ child_link.url }}"
        class="reu-simple-dropdown__link"
        role="menuitem"
        {% if child_link.current %}aria-current="page"{% endif %}
      >
        {{- child_link.title -}}
      </a>
    </li>
  {%- endfor -%}
</ul>
