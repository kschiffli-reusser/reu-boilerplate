{%- doc -%}
  Renders a section intro header with above-line label, heading, and body text.

  @param {string} [above_line] - Small above-headline label above the heading
  @param {string} [heading] - Main heading text
  @param {string} [body_text] - Supporting paragraph text
  @param {string} [alignment] - Text alignment: left | center | right. Default: center
{%- enddoc -%}

{%- liquid
  assign text_alignment = alignment | default: 'center'
-%}

{%- if above_line != blank or heading != blank or body_text != blank -%}
  <div class="reu-section-intro reu-section-intro--{{ text_alignment }}">
    {%- if above_line != blank -%}
      <p class="reu-section-intro__above-headline">{{ above_line }}</p>
    {%- endif -%}
    {%- if heading != blank -%}
      <h2 class="reu-section-intro__heading">{{ heading }}</h2>
    {%- endif -%}
    {%- if body_text != blank -%}
      <p class="reu-section-intro__body">{{ body_text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .reu-section-intro {
    margin-bottom: 3rem;
    width: 100%;
  }

  .reu-section-intro--center {
    text-align: center;
  }

  .reu-section-intro--left {
    text-align: left;
  }

  .reu-section-intro--right {
    text-align: right;
  }

  .reu-section-intro__heading {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 700;
    color: var(--color-foreground-heading);
    line-height: 1.2;
    margin-bottom: 1rem;
    margin-top: 0;
  }

  .reu-section-intro__body {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    line-height: 1.65;
    max-width: 44rem;
    margin-top: 0;
  }

  .reu-section-intro--center .reu-section-intro__body {
    margin-inline: auto;
  }

  .reu-section-intro--right .reu-section-intro__body {
    margin-inline-start: auto;
  }
{% endstylesheet %}
