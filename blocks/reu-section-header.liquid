{%- assign block_settings = block.settings -%}
{%- assign alignment = block_settings.text_alignment | default: 'center' -%}

<div
  class="reu-block-section-header reu-block-section-header--{{ alignment }}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.above_line != blank -%}
    <p class="reu-block-section-header__above-headline">{{ block_settings.above_line }}</p>
  {%- endif -%}
  {%- if block_settings.heading != blank -%}
    <h2 class="reu-block-section-header__heading">{{ block_settings.heading }}</h2>
  {%- endif -%}
  {%- if block_settings.body_text != blank -%}
    <p class="reu-block-section-header__body">{{ block_settings.body_text }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .reu-block-section-header {
    width: 100%;
  }

  .reu-block-section-header--center {
    text-align: center;
  }

  .reu-block-section-header--left {
    text-align: left;
  }

  .reu-block-section-header--right {
    text-align: right;
  }

  .reu-block-section-header__heading {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 700;
    color: var(--color-foreground-heading);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .reu-block-section-header__body {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    line-height: 1.65;
    max-width: 44rem;
    margin: 0;
  }

  .reu-block-section-header--center .reu-block-section-header__body {
    margin-inline: auto;
  }

  .reu-block-section-header--right .reu-block-section-header__body {
    margin-inline-start: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PB: Section Header",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your section title here"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Add a supporting sentence to give context to the content that follows."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "PB: Section Header",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
