{%- liquid
  assign block_settings = block.settings
  assign text_alignment = block_settings.text_alignment | default: 'center'
-%}

<div
  class="reu-block-cta-banner reu-block-cta-banner--{{ text_alignment }}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.background_image != blank -%}
    <div class="reu-block-cta-banner__bg" aria-hidden="true">
      <img
        src="{{ block_settings.background_image | image_url: width: 2000 }}"
        srcset="
          {{ block_settings.background_image | image_url: width: 750 }} 750w,
          {{ block_settings.background_image | image_url: width: 1500 }} 1500w,
          {{ block_settings.background_image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ block_settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block_settings.background_image.width }}"
        height="{{ block_settings.background_image.height }}"
      >
    </div>
  {%- endif -%}

  <div
    class="reu-block-cta-banner__overlay"
    aria-hidden="true"
    style="opacity: {{ block_settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <div class="reu-block-cta-banner__content">
    {%- if block_settings.above_line != blank -%}
      <p class="reu-block-cta-banner__above-headline">{{ block_settings.above_line }}</p>
    {%- endif -%}

    {%- if block_settings.heading != blank -%}
      <h2 class="reu-block-cta-banner__heading">{{ block_settings.heading }}</h2>
    {%- endif -%}

    {%- if block_settings.body_text != blank -%}
      <p class="reu-block-cta-banner__body">{{ block_settings.body_text }}</p>
    {%- endif -%}

    {%- if block_settings.button_1_label != blank or block_settings.button_2_label != blank -%}
      <div class="reu-block-cta-banner__buttons">
        {%- if block_settings.button_1_label != blank -%}
          <a
            {% if block_settings.button_1_link != blank %}href="{{ block_settings.button_1_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            class="{{ block_settings.button_1_style }}"
          >{{ block_settings.button_1_label }}</a>
        {%- endif -%}
        {%- if block_settings.button_2_label != blank -%}
          <a
            {% if block_settings.button_2_link != blank %}href="{{ block_settings.button_2_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            class="{{ block_settings.button_2_style }}"
          >{{ block_settings.button_2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .reu-block-cta-banner {
    position: relative;
    overflow: hidden;
    min-height: 40svh;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .reu-block-cta-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .reu-block-cta-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reu-block-cta-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--color-background);
  }

  .reu-block-cta-banner__content {
    position: relative;
    z-index: 2;
    padding: max(3rem, 6svh) max(1.5rem, 5vw);
    width: 100%;
    max-width: 54rem;
  }

  .reu-block-cta-banner--center .reu-block-cta-banner__content {
    margin-inline: auto;
    text-align: center;
  }

  .reu-block-cta-banner--right .reu-block-cta-banner__content {
    margin-inline-start: auto;
    text-align: right;
  }

  .reu-block-cta-banner__heading {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 700;
    color: var(--color-foreground-heading);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .reu-block-cta-banner__body {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    line-height: 1.65;
    margin: 0 0 0.5rem;
    max-width: 42rem;
  }

  .reu-block-cta-banner--center .reu-block-cta-banner__body {
    margin-inline: auto;
  }

  .reu-block-cta-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .reu-block-cta-banner--center .reu-block-cta-banner__buttons {
    justify-content: center;
  }

  .reu-block-cta-banner--right .reu-block-cta-banner__buttons {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PB: CTA Banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A bold headline goes here"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Supporting copy that provides more context about what you're offering."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Style",
      "options": [
        { "value": "button", "label": "Primary" },
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Style",
      "options": [
        { "value": "button", "label": "Primary" },
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ],
      "default": "button-secondary"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "PB: CTA Banner",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
