{%- assign block_settings = block.settings -%}

<div class="reu-block-cta" {{ block.shopify_attributes }}>
  {%- if block_settings.richtext != blank -%}
    <div class="reu-block-cta__text rte">{{ block_settings.richtext }}</div>
  {%- endif -%}

  {%- if block_settings.button_1_label != blank or block_settings.button_2_label != blank -%}
    <div class="reu-block-cta__buttons">
      {%- if block_settings.button_1_label != blank -%}
        <a
          {% if block_settings.button_1_link != blank %}href="{{ block_settings.button_1_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="{{ block_settings.button_1_style }}"
        >{{ block_settings.button_1_label }}</a>
      {%- endif -%}
      {%- if block_settings.button_2_label != blank -%}
        <a
          {% if block_settings.button_2_link != blank %}href="{{ block_settings.button_2_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="{{ block_settings.button_2_style }}"
        >{{ block_settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .reu-block-cta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background-color: var(--color-background);
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .reu-block-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }

  .reu-block-cta__text {
    flex: 1;
  }

  .reu-block-cta__text h1,
  .reu-block-cta__text h2,
  .reu-block-cta__text h3,
  .reu-block-cta__text h4 {
    margin-top: 0;
    color: var(--color-foreground-heading);
  }

  .reu-block-cta__text p:last-child {
    margin-bottom: 0;
  }

  .reu-block-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex-shrink: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PB: Call to Action",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Content",
      "default": "<h3>Ready to get started?</h3><p>Join thousands of happy customers today.</p>"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Style",
      "options": [
        { "value": "button", "label": "Primary" },
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Style",
      "options": [
        { "value": "button", "label": "Primary" },
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ],
      "default": "button-secondary"
    }
  ],
  "presets": [
    {
      "name": "PB: Call to Action",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
