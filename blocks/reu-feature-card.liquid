{%- assign block_settings = block.settings -%}
{%- assign alignment = block_settings.alignment | default: 'left' -%}

<div
  class="reu-block-feature-card reu-block-feature-card--{{ alignment }}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.icon != blank -%}
    <div class="reu-block-feature-card__icon">
      <img
        src="{{ block_settings.icon | image_url: width: 80 }}"
        alt="{{ block_settings.icon.alt | escape }}"
        width="40"
        height="40"
        loading="lazy"
      >
    </div>
  {%- endif -%}

  {%- if block_settings.heading != blank -%}
    <h3 class="reu-block-feature-card__heading">{{ block_settings.heading }}</h3>
  {%- endif -%}

  {%- if block_settings.body != blank -%}
    <p class="reu-block-feature-card__body">{{ block_settings.body }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .reu-block-feature-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    height: 100%;
  }

  .reu-block-feature-card--center {
    align-items: center;
    text-align: center;
  }

  .reu-block-feature-card--right {
    align-items: flex-end;
    text-align: right;
  }

  .reu-block-feature-card__icon {
    margin-bottom: 1.125rem;
  }

  .reu-block-feature-card__icon img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .reu-block-feature-card__heading {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-foreground-heading);
    margin: 0 0 0.625rem;
  }

  .reu-block-feature-card__body {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    line-height: 1.65;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PB: Feature Card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feature title"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Describe this feature or benefit in a sentence or two."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "PB: Feature Card",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
