{%- liquid
  assign block_settings = block.settings
  assign video_url = block_settings.video_url
  assign embed_url = ''

  if video_url contains 'youtube.com/watch'
    assign video_id = video_url | split: 'v=' | last | split: '&' | first
    assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0'
  elsif video_url contains 'youtu.be/'
    assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
    assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0'
  elsif video_url contains 'vimeo.com/'
    assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
    assign embed_url = 'https://player.vimeo.com/video/' | append: video_id
  endif
-%}

<div class="reu-block-video-embed" {{ block.shopify_attributes }}>
  {%- if embed_url != blank -%}
    <div class="reu-block-video-embed__frame">
      <iframe
        src="{{ embed_url }}"
        title="{{ block_settings.title | default: 'Video' | escape }}"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  {%- elsif video_url != blank -%}
    <div class="reu-block-video-embed__error">
      <p>Unable to embed video. Please use a YouTube or Vimeo URL.</p>
    </div>
  {%- else -%}
    <div class="reu-block-video-embed__placeholder">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm14.024-.983a1.125 1.125 0 010 1.966l-5.603 3.113A1.125 1.125 0 019 15.113V8.887c0-.857.921-1.4 1.671-.983l5.603 3.113z" clip-rule="evenodd" />
      </svg>
      <p>Add a YouTube or Vimeo URL</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .reu-block-video-embed {
    width: 100%;
  }

  .reu-block-video-embed__frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #000;
  }

  .reu-block-video-embed__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .reu-block-video-embed__error,
  .reu-block-video-embed__placeholder {
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 2px dashed var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.6;
  }

  .reu-block-video-embed__placeholder svg {
    width: 3rem;
    height: 3rem;
  }

  .reu-block-video-embed__placeholder p,
  .reu-block-video-embed__error p {
    font-size: 0.9375rem;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PB: Video Embed",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Supports YouTube (youtube.com/watch?v=... or youtu.be/...) and Vimeo (vimeo.com/...) URLs",
      "placeholder": "https://www.youtube.com/watch?v=..."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accessible title",
      "info": "Describes the video for screen readers"
    }
  ],
  "presets": [
    {
      "name": "PB: Video Embed",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
