{%- assign block_settings = block.settings -%}

<div class="reu-block-iws" {{ block.shopify_attributes }}>
  <div class="reu-block-iws__media">
    {%- if block_settings.image != blank -%}
      <img
        src="{{ block_settings.image | image_url: width: 900 }}"
        srcset="
          {{ block_settings.image | image_url: width: 480 }} 480w,
          {{ block_settings.image | image_url: width: 900 }} 900w
        "
        sizes="(min-width: 750px) 50vw, 100vw"
        alt="{{ block_settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block_settings.image.width }}"
        height="{{ block_settings.image.height }}"
      >
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'reu-block-iws__placeholder' }}
    {%- endif -%}
  </div>

  <div class="reu-block-iws__stats">
    {%- for i in (1..5) -%}
      {%- liquid
        assign value_key = 'stat_' | append: i | append: '_value'
        assign headline_key = 'stat_' | append: i | append: '_headline'
        assign desc_key = 'stat_' | append: i | append: '_description'
        assign stat_value = block_settings[value_key]
        assign stat_headline = block_settings[headline_key]
        assign stat_desc = block_settings[desc_key]
      -%}
      {%- if stat_value != blank or stat_headline != blank -%}
        <div class="reu-block-iws__card">
          {%- if stat_value != blank -%}
            <p class="reu-block-iws__value">{{ stat_value }}</p>
          {%- endif -%}
          <div class="reu-block-iws__card-text">
            {%- if stat_headline != blank -%}
              <h4 class="reu-block-iws__headline">{{ stat_headline }}</h4>
            {%- endif -%}
            {%- if stat_desc != blank -%}
              <p class="reu-block-iws__desc">{{ stat_desc }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .reu-block-iws {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .reu-block-iws {
      grid-template-columns: 1fr 1fr;
    }
  }

  .reu-block-iws__media img,
  .reu-block-iws__media svg {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    display: block;
  }

  .reu-block-iws__placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-border);
  }

  .reu-block-iws__stats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .reu-block-iws__card {
    display: flex;
    align-items: flex-start;
    gap: 1.125rem;
    padding: 1.25rem;
    border-left: 4px solid var(--color-primary);
    border-radius: 0 0.5rem 0.5rem 0;
    background-color: rgba(var(--color-background-rgb, 255,255,255), 0.5);
  }

  .reu-block-iws__value {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    margin: 0;
    min-width: 4rem;
    flex-shrink: 0;
  }

  .reu-block-iws__card-text {
    flex: 1;
  }

  .reu-block-iws__headline {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-foreground-heading);
    margin: 0 0 0.2rem;
  }

  .reu-block-iws__desc {
    font-size: 0.875rem;
    color: var(--color-foreground);
    line-height: 1.55;
    margin: 0;
  }
{% endstylesheet %}

