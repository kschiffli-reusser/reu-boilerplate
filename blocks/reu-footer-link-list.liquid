{%- assign block_settings = block.settings -%}

<div class="reu-footer-link-list" {{ block.shopify_attributes }}>
  {%- if block_settings.heading != blank -%}
    <p class="reu-footer-link-list__heading">{{ block_settings.heading }}</p>
  {%- endif -%}

  <ul class="reu-footer-link-list__list">
    {%- for i in (1..6) -%}
      {%- assign label_key = 'link_' | append: i | append: '_label' -%}
      {%- assign url_key = 'link_' | append: i | append: '_url' -%}
      {%- assign link_label = block_settings[label_key] -%}
      {%- assign link_url = block_settings[url_key] -%}
      {%- if link_label != blank -%}
        <li>
          {%- if link_url != blank -%}
            <a href="{{ link_url }}" class="reu-footer-link-list__link">{{ link_label }}</a>
          {%- else -%}
            <span class="reu-footer-link-list__link">{{ link_label }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .reu-footer-link-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .reu-footer-link-list__heading {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .reu-footer-link-list__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .reu-footer-link-list__link {
    font-size: 0.875rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  a.reu-footer-link-list__link:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

