{%- liquid
  assign block_settings = block.settings
  assign initials = ''
  if block_settings.name != blank
    assign name_parts = block_settings.name | split: ' '
    assign initials = name_parts[0] | slice: 0
    if name_parts.size > 1
      assign last_initial = name_parts[name_parts.size | minus: 1] | slice: 0
      assign initials = initials | append: last_initial
    endif
    assign initials = initials | upcase
  endif
-%}

<div class="reu-block-testimonial" {{ block.shopify_attributes }}>
  <div class="reu-block-testimonial__sidebar">
    {%- if block_settings.background_image != blank -%}
      <div class="reu-block-testimonial__sidebar-bg" aria-hidden="true">
        <img
          src="{{ block_settings.background_image | image_url: width: 600 }}"
          alt="{{ block_settings.background_image.alt | escape }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}
    <div class="reu-block-testimonial__author">
      <div class="reu-block-testimonial__avatar">
        {%- if block_settings.avatar_image != blank -%}
          <img
            src="{{ block_settings.avatar_image | image_url: width: 80 }}"
            alt="{{ block_settings.avatar_image.alt | default: block_settings.name | escape }}"
            loading="lazy"
            width="56"
            height="56"
          >
        {%- elsif initials != blank -%}
          <span aria-hidden="true">{{ initials }}</span>
        {%- endif -%}
      </div>
      {%- if block_settings.name != blank -%}
        <p class="reu-block-testimonial__name">{{ block_settings.name }}</p>
      {%- endif -%}
      {%- if block_settings.position != blank -%}
        <p class="reu-block-testimonial__position">{{ block_settings.position }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="reu-block-testimonial__quote-wrap">
    {%- if block_settings.quote != blank -%}
      <blockquote class="reu-block-testimonial__quote">
        <span class="reu-block-testimonial__quote-mark" aria-hidden="true">&ldquo;</span>
        <p>{{ block_settings.quote }}</p>
      </blockquote>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .reu-block-testimonial {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .reu-block-testimonial {
      grid-template-columns: 260px 1fr;
    }
  }

  .reu-block-testimonial__sidebar {
    position: relative;
    min-height: 200px;
    display: flex;
    align-items: flex-end;
    background-color: var(--color-primary);
  }

  .reu-block-testimonial__sidebar-bg {
    position: absolute;
    inset: 0;
  }

  .reu-block-testimonial__sidebar-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    mix-blend-mode: multiply;
  }

  .reu-block-testimonial__author {
    position: relative;
    z-index: 1;
    padding: 1.25rem;
    color: #fff;
  }

  .reu-block-testimonial__avatar {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.6);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255,255,255,0.2);
    margin-bottom: 0.625rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: #fff;
  }

  .reu-block-testimonial__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reu-block-testimonial__name {
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0 0 0.2rem;
  }

  .reu-block-testimonial__position {
    font-size: 0.8125rem;
    margin: 0;
    opacity: 0.75;
  }

  .reu-block-testimonial__quote-wrap {
    display: flex;
    align-items: center;
    padding: 2rem 2.25rem;
  }

  .reu-block-testimonial__quote {
    margin: 0;
  }

  .reu-block-testimonial__quote-mark {
    display: block;
    font-size: 4.5rem;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: -0.75rem;
    font-family: Georgia, serif;
  }

  .reu-block-testimonial__quote p {
    font-size: clamp(0.9375rem, 1.5vw, 1.1875rem);
    line-height: 1.7;
    color: var(--color-foreground);
    font-style: italic;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PB: Testimonial",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "This is the most impressive product I've ever used. It completely changed the way I work."
    },
    {
      "type": "header",
      "content": "Author"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Jane Smith"
    },
    {
      "type": "text",
      "id": "position",
      "label": "Title / Position",
      "default": "CEO, Acme Co."
    },
    {
      "type": "image_picker",
      "id": "avatar_image",
      "label": "Avatar image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Sidebar background image"
    }
  ],
  "presets": [
    {
      "name": "PB: Testimonial",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
