{%- assign block_settings = block.settings -%}

<div class="pb-footer-social-link-list" {{ block.shopify_attributes }}>
  {%- if block_settings.heading != blank -%}
    <p class="pb-footer-link-list__heading">{{ block_settings.heading }}</p>
  {%- endif -%}

  <ul class="pb-footer-link-list__list">
    {%- for i in (1..6) -%}
      {%- assign label_key = 'link_' | append: i | append: '_label' -%}
      {%- assign url_key   = 'link_' | append: i | append: '_url' -%}
      {%- assign link_label = block_settings[label_key] -%}
      {%- assign link_url   = block_settings[url_key] -%}
      {%- if link_label != blank -%}
        {%- assign platform = link_url | split: '//' | last | remove: 'www.' | split: '.' | first -%}
        <li>
          {%- if link_url != blank -%}
            <a href="{{ link_url }}" class="pb-footer-social-link-list__link" target="_blank" rel="noopener noreferrer">
          {%- else -%}
            <span class="pb-footer-social-link-list__link">
          {%- endif -%}
              <svg
                class="pb-footer-social-link-list__icon"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
              >
                {%- render 'icon', icon: platform -%}
              </svg>
              {{ link_label }}
          {%- if link_url != blank -%}
            </a>
          {%- else -%}
            </span>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .pb-footer-social-link-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pb-footer-social-link-list__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  a.pb-footer-social-link-list__link:hover {
    text-decoration: underline;
  }

  .pb-footer-social-link-list__icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    fill: currentColor;
  }
{% endstylesheet %}

