{%- liquid
  assign embed_url = ''
  assign video_url = section.settings.video_url

  if video_url contains 'youtube.com/watch'
    assign video_id = video_url | split: 'v=' | last | split: '&' | first
    assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0'
  elsif video_url contains 'youtu.be/'
    assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
    assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0'
  elsif video_url contains 'vimeo.com/'
    assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
    assign embed_url = 'https://player.vimeo.com/video/' | append: video_id
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style pb-video-embed"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="pb-video-embed__inner">
    {%- render 'pb-section-intro',
      above_line: section.settings.above_line,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      alignment: 'center'
    -%}

    {%- if embed_url != blank -%}
      <div class="pb-video-embed__frame">
        <iframe
          src="{{ embed_url }}"
          title="{{ section.settings.heading | default: 'Video' | escape }}"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    {%- elsif video_url != blank -%}
      <div class="pb-video-embed__error">
        <p>Unable to embed video. Please use a YouTube or Vimeo URL.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pb-video-embed__inner {
    width: 100%;
  }

  .pb-video-embed__frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .pb-video-embed__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .pb-video-embed__error {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-align: center;
    color: var(--color-foreground);
    font-size: 0.9375rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video Embed",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Supports YouTube (youtube.com/watch?v=... or youtu.be/...) and Vimeo (vimeo.com/...) URLs",
      "placeholder": "https://www.youtube.com/watch?v=..."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Video Embed",
      "category": "★ Custom Sections"
    }
  ]
}
{% endschema %}

