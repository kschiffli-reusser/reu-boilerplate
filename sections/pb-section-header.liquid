<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style pb-section-header"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="pb-section-header__inner pb-section-header__inner--{{ section.settings.text_alignment }}">
    {%- if section.settings.above_line != blank -%}
      <p class="pb-section-header__eyebrow">{{ section.settings.above_line }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="pb-section-header__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <p class="pb-section-header__body">{{ section.settings.body_text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pb-section-header__inner {
    width: 100%;
    max-width: 54rem;
  }

  .pb-section-header__inner--center {
    margin-inline: auto;
    text-align: center;
  }

  .pb-section-header__inner--left {
    text-align: left;
  }

  .pb-section-header__inner--right {
    margin-inline-start: auto;
    text-align: right;
  }

  .pb-section-header__eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .pb-section-header__heading {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    color: var(--color-foreground-heading);
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .pb-section-header__body {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    line-height: 1.65;
    max-width: 44rem;
    margin: 0;
  }

  .pb-section-header__inner--center .pb-section-header__body {
    margin-inline: auto;
  }

  .pb-section-header__inner--right .pb-section-header__body {
    margin-inline-start: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Section Header",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your section title here"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Add a supporting sentence or two to give context to the content that follows."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Section Header",
      "category": "★ Custom Sections"
    }
  ]
}
{% endschema %}

