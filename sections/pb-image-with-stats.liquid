<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style pb-image-with-stats"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="pb-image-with-stats__inner">
    {%- render 'pb-section-intro',
      above_line: section.settings.above_line,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      alignment: 'center'
    -%}

    <div class="pb-image-with-stats__layout">
      <div class="pb-image-with-stats__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="
              {{ section.settings.image | image_url: width: 480 }} 480w,
              {{ section.settings.image | image_url: width: 700 }} 700w,
              {{ section.settings.image | image_url: width: 900 }} 900w
            "
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'pb-image-with-stats__placeholder' }}
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pb-image-with-stats__cards">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="pb-iws-card" {{ block.shopify_attributes }}>
                {%- if block.settings.value != blank -%}
                  <p class="pb-iws-card__value">{{ block.settings.value }}</p>
                {%- endif -%}
                <div class="pb-iws-card__text">
                  {%- if block.settings.headline != blank -%}
                    <h3 class="pb-iws-card__headline">{{ block.settings.headline }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="pb-iws-card__description">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pb-image-with-stats__inner {
    width: 100%;
  }

  .pb-image-with-stats__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .pb-image-with-stats__layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pb-image-with-stats__media img,
  .pb-image-with-stats__media svg {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    display: block;
  }

  .pb-image-with-stats__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-border);
  }

  .pb-image-with-stats__cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pb-iws-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    border-left: 4px solid var(--color-primary);
    background-color: rgba(var(--color-background-rgb, 255, 255, 255), 0.5);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .pb-iws-card__value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    margin: 0;
    flex-shrink: 0;
    min-width: 5rem;
  }

  .pb-iws-card__text {
    flex: 1;
  }

  .pb-iws-card__headline {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-foreground-heading);
    margin: 0 0 0.25rem;
  }

  .pb-iws-card__description {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    line-height: 1.6;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with Stats",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat card",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Stat value",
          "default": "99%",
          "info": "e.g. 10K+, 99%, $1M"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Customer satisfaction"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We measure every experience to ensure our customers are always happy."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Stats",
      "category": "★ Custom Sections",
      "blocks": [
        { "type": "stat", "settings": { "value": "10K+", "headline": "Happy customers", "description": "Trusted by thousands of customers worldwide." } },
        { "type": "stat", "settings": { "value": "99%", "headline": "Satisfaction rate", "description": "Our team works hard to ensure every order delights." } },
        { "type": "stat", "settings": { "value": "5★", "headline": "Average rating", "description": "Consistently top-rated across all review platforms." } }
      ]
    }
  ]
}
{% endschema %}
