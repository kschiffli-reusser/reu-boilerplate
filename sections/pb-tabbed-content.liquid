<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style pb-tabbed-content"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="pb-tabbed-content__inner">
    {%- render 'pb-section-intro',
      above_line: section.settings.above_line,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      alignment: 'center'
    -%}

    {%- if section.blocks.size > 0 -%}
      <pb-tabs class="pb-tabs">
        <div class="pb-tabs__nav" role="tablist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button
                class="pb-tabs__button"
                role="tab"
                data-tab-button
                aria-selected="{{ forloop.first | json }}"
                aria-controls="pb-tab-panel-{{ block.id }}"
                id="pb-tab-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.title }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pb-tabs__panels">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <div
                class="pb-tabs__panel"
                role="tabpanel"
                data-tab-panel
                id="pb-tab-panel-{{ block.id }}"
                aria-labelledby="pb-tab-{{ block.id }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                <div class="pb-tabs__panel-layout">
                  {%- if block.settings.image != blank -%}
                    <div class="pb-tabs__panel-media">
                      <img
                        src="{{ block.settings.image | image_url: width: 800 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 480 }} 480w,
                          {{ block.settings.image | image_url: width: 800 }} 800w
                        "
                        sizes="(min-width: 750px) 50vw, 100vw"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                      >
                    </div>
                  {%- endif -%}

                  <div class="pb-tabs__panel-content">
                    {%- if block.settings.content != blank -%}
                      <div class="pb-tabs__panel-richtext rte">{{ block.settings.content }}</div>
                    {%- endif -%}

                    {%- if block.settings.button_label != blank or block.settings.sec_button_label != blank -%}
                      <div class="pb-tabs__panel-buttons">
                        {%- if block.settings.button_label != blank -%}
                          <a
                            {% if block.settings.button_link != blank %}
                              href="{{ block.settings.button_link }}"
                            {% else %}
                              role="link" aria-disabled="true"
                            {% endif %}
                            class="button"
                          >{{ block.settings.button_label }}</a>
                        {%- endif -%}
                        {%- if block.settings.sec_button_label != blank -%}
                          <a
                            {% if block.settings.sec_button_link != blank %}
                              href="{{ block.settings.sec_button_link }}"
                            {% else %}
                              role="link" aria-disabled="true"
                            {% endif %}
                            class="button-secondary"
                          >{{ block.settings.sec_button_label }}</a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </pb-tabs>
    {%- endif -%}
  </div>
</div>

<script>
  class PbTabs extends HTMLElement {
    connectedCallback() {
      this._buttons = Array.from(this.querySelectorAll('[data-tab-button]'));
      this._panels = Array.from(this.querySelectorAll('[data-tab-panel]'));
      this._buttons.forEach((btn, i) => btn.addEventListener('click', () => this._activate(i)));
    }

    _activate(index) {
      this._buttons.forEach((btn, i) => btn.setAttribute('aria-selected', i === index ? 'true' : 'false'));
      this._panels.forEach((panel, i) => { panel.hidden = i !== index; });
    }
  }

  if (!customElements.get('pb-tabs')) customElements.define('pb-tabs', PbTabs);
</script>

{% stylesheet %}
  .pb-tabbed-content__inner {
    width: 100%;
  }

  .pb-tabs {
    display: block;
    width: 100%;
  }

  .pb-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 2px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .pb-tabs__button {
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-foreground);
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .pb-tabs__button:hover {
    color: var(--color-primary);
  }

  .pb-tabs__button[aria-selected="true"] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .pb-tabs__panel-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .pb-tabs__panel-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pb-tabs__panel-media img {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    display: block;
  }

  .pb-tabs__panel-richtext {
    color: var(--color-foreground);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .pb-tabs__panel-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tabbed Content",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab label",
          "default": "Feature"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<h3>Feature title</h3><p>Describe this feature in detail. Explain the value it provides and why customers will love it.</p>"
        },
        {
          "type": "header",
          "content": "Primary button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Secondary button"
        },
        {
          "type": "text",
          "id": "sec_button_label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "sec_button_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Content",
      "category": "Custom Sections",
      "blocks": [
        { "type": "tab", "settings": { "title": "Design" } },
        { "type": "tab", "settings": { "title": "Materials" } },
        { "type": "tab", "settings": { "title": "Craftsmanship" } }
      ]
    }
  ]
}
{% endschema %}
