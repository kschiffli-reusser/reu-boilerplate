{%- liquid
  assign initials = ''
  if section.settings.name != blank
    assign name_parts = section.settings.name | split: ' '
    assign initials = name_parts[0] | slice: 0
    if name_parts.size > 1
      assign last_initial = name_parts[name_parts.size | minus: 1] | slice: 0
      assign initials = initials | append: last_initial
    endif
    assign initials = initials | upcase
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style pb-testimonial"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="pb-testimonial__inner">
    {%- render 'pb-section-intro',
      above_line: section.settings.above_line,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      alignment: 'center'
    -%}

    <div class="pb-testimonial__card">
      <div class="pb-testimonial__sidebar">
        {%- if section.settings.background_image != blank -%}
          <div class="pb-testimonial__sidebar-bg" aria-hidden="true">
            <img
              src="{{ section.settings.background_image | image_url: width: 600 }}"
              alt="{{ section.settings.background_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.background_image.width }}"
              height="{{ section.settings.background_image.height }}"
            >
          </div>
        {%- endif -%}
        <div class="pb-testimonial__sidebar-content">
          <div class="pb-testimonial__avatar">
            {%- if section.settings.avatar_image != blank -%}
              <img
                src="{{ section.settings.avatar_image | image_url: width: 80 }}"
                alt="{{ section.settings.avatar_image.alt | default: section.settings.name | escape }}"
                loading="lazy"
                width="56"
                height="56"
              >
            {%- else -%}
              <span class="pb-testimonial__initials" aria-hidden="true">{{ initials }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.name != blank -%}
            <p class="pb-testimonial__name">{{ section.settings.name }}</p>
          {%- endif -%}
          {%- if section.settings.position != blank -%}
            <p class="pb-testimonial__position">{{ section.settings.position }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="pb-testimonial__quote-wrap">
        {%- if section.settings.quote != blank -%}
          <blockquote class="pb-testimonial__quote">
            <span class="pb-testimonial__quote-mark" aria-hidden="true">&ldquo;</span>
            <p>{{ section.settings.quote }}</p>
          </blockquote>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .pb-testimonial__inner {
    width: 100%;
  }

  .pb-testimonial__card {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .pb-testimonial__card {
      grid-template-columns: 280px 1fr;
    }
  }

  .pb-testimonial__sidebar {
    position: relative;
    min-height: 220px;
    display: flex;
    align-items: flex-end;
  }

  .pb-testimonial__sidebar-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--color-primary);
  }

  .pb-testimonial__sidebar-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .pb-testimonial__sidebar-content {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
    color: #fff;
  }

  .pb-testimonial__avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.6);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 0.75rem;
  }

  .pb-testimonial__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pb-testimonial__initials {
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
  }

  .pb-testimonial__name {
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
    color: #fff;
  }

  .pb-testimonial__position {
    font-size: 0.8125rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
  }

  .pb-testimonial__quote-wrap {
    display: flex;
    align-items: center;
    padding: 2rem 2.5rem;
  }

  .pb-testimonial__quote {
    margin: 0;
  }

  .pb-testimonial__quote-mark {
    display: block;
    font-size: 5rem;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: -1rem;
    font-family: Georgia, serif;
  }

  .pb-testimonial__quote p {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-foreground);
    margin: 0;
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonial",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "This is the most impressive product I've ever used. It completely transformed the way I work and I couldn't be happier."
    },
    {
      "type": "header",
      "content": "Author"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Jane Smith"
    },
    {
      "type": "text",
      "id": "position",
      "label": "Title / Position",
      "default": "CEO, Acme Co."
    },
    {
      "type": "image_picker",
      "id": "avatar_image",
      "label": "Avatar image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Sidebar background image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Testimonial",
      "category": "★ Custom Sections"
    }
  ]
}
{% endschema %}

