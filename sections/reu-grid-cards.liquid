<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style reu-grid-cards"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="reu-grid-cards__inner">
    {%- render 'reu-section-intro',
      above_line: section.settings.above_line,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      alignment: 'center'
    -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="reu-grid-cards__grid"
        style="--reu-card-columns: {{ section.settings.columns }};"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- capture card_style -%}
              {%- if block.settings.card_bg != blank -%}--reu-card-bg:{{ block.settings.card_bg }};{%- endif -%}
              {%- if block.settings.card_heading != blank -%}--reu-card-heading:{{ block.settings.card_heading }};{%- endif -%}
              {%- if block.settings.card_body != blank -%}--reu-card-body:{{ block.settings.card_body }};{%- endif -%}
            {%- endcapture -%}
            <div
              class="reu-grid-card reu-grid-card--{{ block.settings.alignment }}"
              {% if card_style != blank %}style="{{ card_style }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <div class="reu-grid-card__image" style="--image-radius: {{ block.settings.image_radius }}px; --image-gap: {{ block.settings.image_gap }}px;">
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                </div>
              {%- endif -%}

              {%- if block.settings.icon != blank -%}
                <div class="reu-grid-card__icon" style="--icon-width: {{ block.settings.icon_width }}px;">
                  <img
                    src="{{ block.settings.icon | image_url: width: 200 }}"
                    alt="{{ block.settings.icon.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.icon_width }}"
                    height="{{ block.settings.icon_width }}"
                  >
                </div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="reu-grid-card__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <p class="reu-grid-card__body">{{ block.settings.body }}</p>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="reu-grid-card__button-wrap" style="--button-alignment: {{ block.settings.button_alignment }};">
                  <a
                    {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                    class="{{ block.settings.button_style }}"
                  >{{ block.settings.button_label }}</a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .reu-grid-cards__inner {
    width: 100%;
  }

  .reu-grid-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 600px) {
    .reu-grid-cards__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 750px) {
    .reu-grid-cards__grid {
      grid-template-columns: repeat(var(--reu-card-columns, 3), 1fr);
    }
  }

  .reu-grid-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--reu-card-border);
    border-radius: 0.75rem;
    background-color: var(--reu-card-bg);
  }

  .reu-grid-card--center {
    align-items: center;
    text-align: center;
  }

  .reu-grid-card--right {
    align-items: flex-end;
    text-align: right;
  }

  .reu-grid-card__image {
    width: 100%;
    margin-bottom: var(--image-gap, 1.5rem);
    border-radius: var(--image-radius, 0.75rem);
    overflow: hidden;
  }

  .reu-grid-card__image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .reu-grid-card__icon {
    margin-bottom: 1.25rem;
  }

  .reu-grid-card__icon img {
    width: var(--icon-width, 40px);
    height: auto;
    object-fit: contain;
  }

  .reu-grid-card__heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--reu-card-heading);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .reu-grid-card__body {
    font-size: 0.9375rem;
    color: var(--reu-card-body);
    line-height: 1.65;
    margin: 0;
  }

  .reu-grid-card__button-wrap {
    display: flex;
    justify-content: var(--button-alignment, flex-start);
    margin-top: auto;
    padding-top: 1.5rem;
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Grid Cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Above Headline",
      "default": "What we offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Here's what makes us stand out from the rest."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image (4:3, full width)"
        },
        {
          "type": "range",
          "id": "image_gap",
          "label": "Image bottom padding",
          "min": 0,
          "max": 60,
          "step": 4,
          "unit": "px",
          "default": 24
        },
        {
          "type": "range",
          "id": "image_radius",
          "label": "Image corner radius",
          "min": 0,
          "max": 32,
          "step": 2,
          "unit": "px",
          "default": 12
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "range",
          "id": "icon_width",
          "label": "Icon width",
          "min": 20,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 40
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "Describe this feature or benefit in a sentence or two."
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card background"
        },
        {
          "type": "color",
          "id": "card_heading",
          "label": "Heading color"
        },
        {
          "type": "color",
          "id": "card_body",
          "label": "Body text color"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "button", "label": "Primary" },
            { "value": "button-secondary", "label": "Secondary" },
            { "value": "link", "label": "Link" }
          ],
          "default": "button"
        },
        {
          "type": "select",
          "id": "button_alignment",
          "label": "Button alignment",
          "options": [
            { "value": "flex-start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Right" }
          ],
          "default": "flex-start"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "t:settings.open_new_tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Cards",
      "category": "★ Custom Sections",
      "blocks": [
        {
          "type": "card",
          "settings": { "heading": "Quality materials", "body": "We source only the finest materials from trusted suppliers around the world." }
        },
        {
          "type": "card",
          "settings": { "heading": "Expert craftsmanship", "body": "Every product is made with care by skilled artisans who take pride in their work." }
        },
        {
          "type": "card",
          "settings": { "heading": "100% satisfaction", "body": "Not happy? We'll make it right. Our commitment to you doesn't end at checkout." }
        }
      ]
    }
  ]
}
{% endschema %}

