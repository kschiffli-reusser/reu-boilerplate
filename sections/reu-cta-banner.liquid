<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--full-width color-{{ section.settings.color_scheme }} spacing-style reu-cta-banner"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.background_image != blank -%}
    <div class="reu-cta-banner__bg" aria-hidden="true">
      <img
        src="{{ section.settings.background_image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 750 }} 750w,
          {{ section.settings.background_image | image_url: width: 1100 }} 1100w,
          {{ section.settings.background_image | image_url: width: 1500 }} 1500w,
          {{ section.settings.background_image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
      >
    </div>
  {%- endif -%}

  <div
    class="reu-cta-banner__overlay"
    aria-hidden="true"
    style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <div class="reu-cta-banner__content reu-cta-banner__content--{{ section.settings.text_alignment }}">
    {%- render 'reu-section-intro',
      above_line: section.settings.above_line,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      alignment: section.settings.text_alignment
    -%}

    {%- if section.blocks.size > 0 -%}
      <div class="reu-cta-banner__buttons">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' -%}
            <a
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="{{ block.settings.style }}"
              {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .reu-cta-banner {
    position: relative;
    overflow: hidden;
  }

  .reu-cta-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .reu-cta-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .reu-cta-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--color-background);
  }

  .reu-cta-banner__content {
    position: relative;
    z-index: 2;
    max-width: var(--page-width, 120rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, 40px);
    padding-block: max(4rem, 8svh);
    width: 100%;
  }

  .reu-cta-banner__content--center {
    text-align: center;
  }

  .reu-cta-banner__content--left {
    text-align: left;
  }

  .reu-cta-banner__content--right {
    text-align: right;
  }

  .reu-cta-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .reu-cta-banner__content--center .reu-cta-banner__buttons {
    justify-content: center;
  }

  .reu-cta-banner__content--right .reu-cta-banner__buttons {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA Banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "above_line",
      "label": "Above Headline",
      "default": "Don't miss out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A bold headline goes here"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Supporting copy that provides more context about what you're offering."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "button", "label": "Primary" },
            { "value": "button-secondary", "label": "Secondary" },
            { "value": "link", "label": "Link" }
          ],
          "default": "button"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTA Banner",
      "category": "★ Custom Sections",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Learn more",
            "style": "button"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "View collection",
            "style": "button-secondary"
          }
        }
      ]
    }
  ]
}
{% endschema %}

