<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--full-width color-{{ section.settings.color_scheme }} spacing-style reu-hero-slideshow"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.background_image != blank -%}
    <div class="reu-hero-slideshow__bg" aria-hidden="true">
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 750 }} 750w,
          {{ section.settings.background_image | image_url: width: 1100 }} 1100w,
          {{ section.settings.background_image | image_url: width: 1500 }} 1500w,
          {{ section.settings.background_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="eager"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
      >
    </div>
  {%- endif -%}

  <reu-hero-slideshow
    class="reu-hero-slideshow__stage"
    {%- if section.settings.autoplay and section.blocks.size > 1 -%}
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    {%- endif -%}
  >
    <div class="reu-hero-slideshow__viewport">
      <div class="reu-hero-slideshow__track" data-track>
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div
          class="reu-hero-slideshow__slide"
          data-slide
          {{ block.shopify_attributes }}
        >
          <div class="reu-hero-slideshow__layout">
            <div class="reu-hero-slideshow__card">
              {%- if block.settings.heading != blank -%}
                <h2 class="reu-hero-slideshow__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.body_text != blank -%}
                <p class="reu-hero-slideshow__body">{{ block.settings.body_text }}</p>
              {%- endif -%}
              {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                <div class="reu-hero-slideshow__buttons">
                  {%- if block.settings.button_1_label != blank -%}
                    <a
                      {% if block.settings.button_1_link != blank %}href="{{ block.settings.button_1_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                      class="button"
                    >{{ block.settings.button_1_label }}</a>
                  {%- endif -%}
                  {%- if block.settings.button_2_label != blank -%}
                    <a
                      {% if block.settings.button_2_link != blank %}href="{{ block.settings.button_2_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                      class="{{ block.settings.button_2_style }}"
                    >{{ block.settings.button_2_label }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            <div class="reu-hero-slideshow__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 480 }} 480w,
                    {{ block.settings.image | image_url: width: 900 }} 900w
                  "
                  sizes="(min-width: 750px) 62vw, 100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  {%- if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'reu-hero-slideshow__placeholder' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
      </div><!-- /.reu-hero-slideshow__track -->
    </div><!-- /.reu-hero-slideshow__viewport -->

    {%- if section.blocks.size > 1 -%}
      <div class="reu-hero-slideshow__footer"{% if section.settings.dot_color != blank %} style="--reu-dot-color: {{ section.settings.dot_color }}"{% endif %}>
        <div class="reu-hero-slideshow__dots" role="tablist" aria-label="Slideshow controls">
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' -%}
              <button
                class="reu-hero-slideshow__dot"
                data-dot
                role="tab"
                aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
                aria-selected="{{ forloop.first | json }}"
              ></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </reu-hero-slideshow>
</div>

<script src="{{ 'reu-hero-slideshow.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  .reu-hero-slideshow {
    position: relative;
    overflow: hidden;
  }

  .reu-hero-slideshow__bg {
    grid-column: 1 / -1;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .reu-hero-slideshow__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reu-hero-slideshow__stage {
    display: block;
    position: relative;
    z-index: 1;
    width: calc(100% - var(--page-margin) * 2);
    max-width: var(--page-content-width);
    margin-inline: auto;
  }

  .reu-hero-slideshow__viewport {
    overflow: hidden;
  }

  .reu-hero-slideshow__track {
    display: flex;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reu-hero-slideshow__track {
      transition: transform 0.6s ease-in-out;
    }
  }

  .reu-hero-slideshow__slide {
    min-width: 100%;
    flex-shrink: 0;
  }

  .reu-hero-slideshow__layout {
    display: grid;
    grid-template-columns: 38% 1fr;
    align-items: center;
    min-height: 520px;
    padding: 3rem 2rem 3rem 3rem;
  }

  .reu-hero-slideshow__card {
    position: relative;
    z-index: 2;
    background: var(--reu-card-bg);
    border: 1px solid var(--reu-card-border);
    border-radius: 1rem;
    padding: 3rem 2.5rem;
    align-self: center;
  }

  .reu-hero-slideshow__heading {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--reu-card-heading);
    margin: 0 0 1.25rem;
  }

  .reu-hero-slideshow__body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--reu-card-body);
    margin: 0;
  }

  .reu-hero-slideshow__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .reu-hero-slideshow__media {
    position: relative;
    z-index: 1;
    margin-left: -4rem;
    border-radius: 1rem;
    overflow: hidden;
    height: 520px;
  }

  .reu-hero-slideshow__media img,
  .reu-hero-slideshow__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reu-hero-slideshow__footer {
    position: relative;
    z-index: 2;
    padding: 1.25rem 0 2rem 3rem;
  }

  .reu-hero-slideshow__dots {
    display: flex;
    gap: 0.625rem;
    align-items: center;
  }

  .reu-hero-slideshow__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    cursor: pointer;
    background: var(--reu-dot-color, var(--color-background));
    opacity: 0.45;
    transition: opacity 0.2s;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
  }

  .reu-hero-slideshow__dot[aria-selected="true"] {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .reu-hero-slideshow__layout {
      grid-template-columns: 1fr;
      min-height: unset;
      padding: 1.5rem 1rem;
      gap: 0;
    }

    .reu-hero-slideshow__card {
      order: 2;
      border-radius: 0 0 1rem 1rem;
      border-top: none;
    }

    .reu-hero-slideshow__media {
      order: 1;
      margin-left: 0;
      height: 280px;
      border-radius: 1rem 1rem 0 0;
    }

    .reu-hero-slideshow__footer {
      padding-left: 1rem;
    }

    .reu-hero-slideshow__dots {
      padding-left: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Slideshow",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Behind every product is a pair of hands."
        },
        {
          "type": "textarea",
          "id": "body_text",
          "label": "Body text",
          "default": "Dignified employment can break the chains of poverty and exploitation."
        },
        {
          "type": "header",
          "content": "Primary button"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Label",
          "default": "About Us"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Secondary button"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "label": "Style",
          "options": [
            { "value": "button-secondary", "label": "Secondary" },
            { "value": "link", "label": "Link" }
          ],
          "default": "button-secondary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "category": "★ Custom Sections",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Behind every product is a pair of hands." } },
        { "type": "slide", "settings": { "heading": "Our artisans create with intention." } },
        { "type": "slide", "settings": { "heading": "Fair trade. Fair wages. Fair world." } }
      ]
    }
  ]
}
{% endschema %}
